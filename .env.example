# =============================================================================
# DocuFlow — environment variables
# Copy to .env.local and fill in. NEVER commit real values.
# =============================================================================

# --- Public (exposed to the browser) ----------------------------------------
# Supabase project URL and anon/publishable key (Project Settings → API).
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Root domain that hosts tenant subdomains, WITHOUT protocol.
#   Production: example.com          → tenants at https://{slug}.example.com
#   Local dev:  localhost:3000
NEXT_PUBLIC_ROOT_DOMAIN=localhost:3000

# How tenants are addressed:
#   subdomain → https://{slug}.example.com  (production, needs wildcard DNS)
#   path      → http://localhost:3000/t/{slug} (local development / previews)
NEXT_PUBLIC_TENANT_ROUTING=path

# Product name shown in the UI.
NEXT_PUBLIC_APP_NAME=DocuFlow

# --- Server only ----------------------------------------------------------------
# Central application URL (login, invitations, password reset links).
#   Production example: https://app.example.com
APP_URL=http://localhost:3000

# Supabase service role key. SERVER ONLY. Never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Cookie domain used to share the session between subdomains.
#   Production (subdomain routing): .example.com
#   Local dev (path routing): leave empty
AUTH_COOKIE_DOMAIN=

# --- AI provider -----------------------------------------------------------------
# gemini | mock   (mock returns synthetic data; for development and tests only)
AI_PROVIDER=mock
GEMINI_API_KEY=
# Model name is configuration, not code. Use the current "Flash" model listed in Google AI Studio
# (older models are retired for new accounts; the error message names the replacement).
GEMINI_MODEL=gemini-2.5-flash
# Maximum time for a single extraction call (ms).
AI_TIMEOUT_MS=90000

# --- Email -----------------------------------------------------------------------
# console | resend   (console only logs that an email would be sent; dev only)
EMAIL_PROVIDER=console
EMAIL_FROM="DocuFlow <no-reply@example.com>"
RESEND_API_KEY=

# --- Operations ------------------------------------------------------------------
# debug | info | warn | error
LOG_LEVEL=info
# Shared secret for scheduled jobs (e.g. Vercel Cron → /api/cron/alerts).
CRON_SECRET=
